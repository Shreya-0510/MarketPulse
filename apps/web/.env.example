# Leave VITE_API_BASE_URL empty to use same-origin /api (Vite proxy in dev, nginx proxy in Docker).
# Set an absolute URL only when the API is on another origin (then set CORS_ORIGINS on the API).
VITE_API_BASE_URL=
# Dev-server proxy target (npm run dev only)
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Optional explicit WebSocket base (e.g. ws://localhost:8000). Empty = derive from VITE_API_BASE_URL / page origin.
VITE_WS_BASE_URL=
