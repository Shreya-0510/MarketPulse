# Copy to .env (Windows PowerShell: Copy-Item .env.example .env)
# No secrets are required for the default local setup.

# --- Kafka ---
# Inside Docker network:
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# From the Windows host (tools, tests run outside Docker):
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092

# --- MongoDB (standalone, no auth in local dev; port is bound to 127.0.0.1 only) ---
MONGO_URI=mongodb://mongodb:27017
MONGO_URI_HOST=mongodb://localhost:27017
MONGO_DB=marketpulse

# --- Application ---
MARKETPULSE_CONFIG_DIR=/app/config
API_PORT=8000
LOG_LEVEL=INFO

# --- Spark streaming ---
SPARK_TRIGGER_SECONDS=10
SPARK_DRIVER_MEMORY=1g
CHECKPOINT_ROOT=/checkpoints

# --- API ---
STALE_AFTER_DAYS=4

# --- Retention (TTL on ingested_at; 0 = keep forever). Applied by mongo-init at startup ---
SOCIAL_RETENTION_DAYS=14
NEWS_RETENTION_DAYS=30

# Slice 5 — Analytics
ANALYTICS_INTERVAL_SECONDS=300   # how often analytics_job recomputes metrics (seconds)

# Slice 6 — Web dashboard
WEB_PORT=3000                 # http://localhost:3000 (Docker, nginx). Dev server (npm run dev) uses 5173.
# Leave empty for same-origin /api (recommended). Baked into the web image at build time if set.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# Only needed if the browser calls the API cross-origin, e.g. CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
